# ===== Syriana Energy - environment (copy to .env) =====
# Used by docker-compose and by the backend (pydantic-settings reads the same names).

# --- General ---
# development | test | production (production refuses weak secrets)
APP_ENV=production
# public URL of the web app (links in messages)
PUBLIC_BASE_URL=https://energy.example.com
# Secure flag on the se_session cookie; true behind HTTPS, false for plain http dev
COOKIE_SECURE=true
# default e-mail for `python -m app.cli create-superadmin`
SUPERADMIN_EMAIL=admin@example.com

# --- Database / cache ---
# compose only: db container credentials
POSTGRES_USER=se
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syriana_energy
# compose builds DATABASE_URL/REDIS_URL for api+worker itself. Set them here for non-compose runs:
# postgresql:// also accepted
DATABASE_URL=postgresql+asyncpg://se:change-me@localhost:5432/syriana_energy
# optional; empty => in-memory rate limiting, no cross-worker poll lock
REDIS_URL=redis://localhost:6379/0

# --- Secrets (REQUIRED in production) ---
# >= 32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Fernet key for device credentials: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# --- Telegram bot (optional) ---
# from @BotFather; enables long-polling in the worker
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SyrianaEnergyBot
# enables POST /api/telegram/webhook/<secret> (webhook mode instead of polling)
TELEGRAM_WEBHOOK_SECRET=

# --- E-mail (optional, SMTP via aiosmtplib) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Syriana Energy <no-reply@example.com>
SMTP_STARTTLS=true

# --- AI assistant (optional; without a key /api/assistant/chat answers 503 ai_unavailable) ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Billing (Odoo -> POST /api/billing/odoo/webhook with header X-Odoo-Secret) ---
ODOO_WEBHOOK_SECRET=

# --- Device clouds ---
SHINEMONITOR_BASE=http://android.shinemonitor.com/public/

# --- Hardening knobs (rarely changed) ---
# true lets webhooks/automation HTTP actions reach private IPs (SSRF guard off)
ALLOW_PRIVATE_URLS=false
# failed logins per window per (ip, email)
LOGIN_RATE_LIMIT=8
# seconds
LOGIN_RATE_WINDOW=300
# header carrying the real client IP from your edge proxy (cf-connecting-ip behind Cloudflare).
# empty => direct peer address. X-Forwarded-For is never trusted.
CLIENT_IP_HEADER=cf-connecting-ip
# extra hosts tenants may never claim as custom_domain (comma list; PUBLIC_BASE_URL's host is always reserved)
RESERVED_DOMAINS=
# AI assistant requests per tenant
ASSISTANT_HOURLY_LIMIT=30
ASSISTANT_DAILY_LIMIT=200
# days readings survive past the plan's history window (protects late renewals)
RETENTION_GRACE_DAYS=30
# interactive API docs at /api/docs (default: off in production)
# API_DOCS=true
